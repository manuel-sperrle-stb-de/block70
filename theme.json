{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"gradients": [
				{
					"gradient": "linear-gradient(90deg, var(--wp--preset--color--keycolor) 0%, var(--wp--preset--color--segmentcolor) 100%)",
					"name": "Farbverlauf",
					"slug": "gradient"
				}
			],
			"palette": [
				{
					"color": "#8F0000",
					"name": "keycolor",
					"slug": "keycolor"
				},
				{
					"color": "#FF1900",
					"name": "segmentcolor",
					"slug": "segmentcolor"
				},
				{
					"color": "#333333",
					"name": "dark",
					"slug": "dark"
				},
				{
					"color": "#9D9D9D",
					"name": "medium",
					"slug": "medium"
				},
				{
					"color": "#E3E3E3",
					"name": "light",
					"slug": "light"
				},
				{
					"color": "#000000",
					"name": "black",
					"slug": "black"
				},
				{
					"color": "#FFFFFF",
					"name": "white",
					"slug": "white"
				}
			]
		},
		"layout": {
			"allowEditing": false,
			"allowCustomContentAndWideSize": false,
			"contentSize": "40rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": ".25rem / 4px",
					"size": ".25rem",
					"slug": "025"
				},
				{
					"name": ".50rem / 8px",
					"size": ".50rem",
					"slug": "050"
				},
				{
					"name": ".75rem / 12px",
					"size": ".75rem",
					"slug": "075"
				},
				{
					"name": "1rem / 16px",
					"size": "1rem",
					"slug": "100"
				},
				{
					"name": "1.25rem / 20px",
					"size": "1.25rem",
					"slug": "125"
				},
				{
					"name": "1.5rem / 24px",
					"size": "1.5rem",
					"slug": "150"
				},
				{
					"name": "1.75rem / 28px",
					"size": "1.75rem",
					"slug": "175"
				},
				{
					"name": "2rem / 32px",
					"size": "2rem",
					"slug": "200"
				},
				{
					"name": "3rem / 48px",
					"size": "3rem",
					"slug": "300"
				},
				{
					"name": "5rem / 80px",
					"size": "5rem",
					"slug": "500"
				},
				{
					"name": "8rem / 128px",
					"size": "8rem",
					"slug": "800"
				},
				{
					"name": "13rem / 208px",
					"size": "13rem",
					"slug": "1300"
				}
			],
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Arimo",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/arimo-v29-latin/arimo-v29-latin-400.woff2"
							]
						},
						{
							"fontFamily": "Arimo",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/arimo-v29-latin/arimo-v29-latin-700.woff2"
							]
						}
					],
					"fontFamily": "Arimo",
					"slug": "arimo"
				},
				{
					"fontFace": [
						{
							"fontFamily": "League Spartan",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/league-spartan-v11-latin/league-spartan-v11-latin-400.woff2"
							]
						},
						{
							"fontFamily": "League Spartan",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/league-spartan-v11-latin/league-spartan-v11-latin-700.woff2"
							]
						}
					],
					"fontFamily": "League Spartan",
					"slug": "league-spartan"
				}
			],
			"fontSizes": [
				{
					"fluid": false,
					"size": ".75rem",
					"slug": "xs",
					"name": "XS (0,75rem / 12px)"
				},
				{
					"fluid": false,
					"size": ".875rem",
					"slug": "s",
					"name": "S (0,875rem / 14px)"
				},
				{
					"fluid": false,
					"size": "1rem",
					"slug": "m",
					"name": "M (h6 / 1rem / 16px)"
				},
				{
					"fluid": false,
					"size": "1.125rem",
					"slug": "l",
					"name": "L (h5 / 1,125rem / 18px)"
				},
				{
					"fluid": false,
					"size": "1.375rem",
					"slug": "xl",
					"name": "XL (h4 / 1,375rem / 22px)"
				},
				{
					"fluid": false,
					"size": "2rem",
					"slug": "2xl",
					"name": "2XL (h3 / 2rem / 32px)"
				},
				{
					"fluid": false,
					"size": "2.188rem",
					"slug": "3xl",
					"name": "3XL (h1,h2 / 2,188rem / 35px)"
				},
				{
					"fluid": false,
					"size": "2.5rem",
					"slug": "4xl",
					"name": "4XL (h1 / 2,5rem / 40px)"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"blocks": {
			"core/accordion-heading": {
				"color": {
					"text": "var(--wp--preset--color--dark)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--dark)"
						}
					}
				},
				"border": {
					"color": null,
					"style": null,
					"width": null,
					"top": {
						"color": "#333333",
						"style": "solid",
						"width": "1px"
					},
					"right": {
						"color": "#333333",
						"style": "solid",
						"width": "1px"
					},
					"bottom": {
						"color": "#333333",
						"style": "solid",
						"width": "1px"
					},
					"left": {
						"color": "#333333",
						"style": "solid",
						"width": "1px"
					},
					"radius": {
						"topLeft": "0.5rem",
						"topRight": "0.5rem",
						"bottomLeft": "0.5rem",
						"bottomRight": "0.5rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--league-spartan)",
					"fontSize": "var(--wp--preset--font-size--l)"
				}
			},
			"core/breadcrumbs": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--league-spartan)"
				}
			},
			"core/button": {
				"color": {
					"text": "var(--wp--preset--color--white)",
					"gradient": "var(--wp--preset--gradient--gradient)"
				},
				"variations": {
					"sprungmarke": {
						"css": "background-image: none; min-height: 5.375rem; min-width: 10rem;",
						"color": {
							"background": "var(--wp--preset--color--keycolor)"
						},
						"border": {
							"radius": {
								"topLeft": "0.5rem",
								"topRight": "0.5rem",
								"bottomLeft": "0.5rem",
								"bottomRight": "0.5rem"
							}
						},
						"typography": {
							"textTransform": "uppercase"
						}
					}
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--league-spartan)"
				},
				"border": {
					"radius": {
						"topLeft": "0.3125rem",
						"topRight": "0.3125rem",
						"bottomLeft": "0.3125rem",
						"bottomRight": "0.3125rem"
					}
				}
			},
			"core/list": {
				"variations": {
					"mitstrichen": {
						"css": ""
					}
				}
			}
		},
		"color": {
			"text": "var(--wp--preset--color--black)"
		},
		"elements": {
			"button": {
				"color": {
					"gradient": "var(--wp--preset--gradient--gradient)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--league-spartan)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--m)",
					"fontStyle": "normal"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--arimo)",
					"fontSize": "var(--wp--preset--font-size--m)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--league-spartan)",
					"fontStyle": "normal",
					"fontWeight": "700",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--4-xl)",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3-xl)",
					"textTransform": "uppercase"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--3-xl)",
					"textTransform": "uppercase"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--2-xl)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xl)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--l)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--black)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--arimo)",
					"fontSize": "var(--wp--preset--font-size--m)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			}
		},
		"spacing": {
			"padding": {
				"top": "0px",
				"right": "var(--wp--preset--spacing--100)",
				"bottom": "0px",
				"left": "var(--wp--preset--spacing--100)"
			},
			"blockGap": "var(--wp--preset--spacing--100)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--arimo)",
			"fontSize": "var(--wp--preset--font-size--m)",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.4"
		}
	}
}
